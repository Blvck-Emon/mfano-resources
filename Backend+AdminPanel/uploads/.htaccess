# Backend+AdminPanel/uploads/.htaccess
#
# includes/upload.php already validates every upload's real MIME type
# (finfo) and extension before it lands here, and stores it under a
# random 32-hex-char filename — but defense in depth costs nothing.
# This folder must stay readable (the admin "View" button and any
# external file_url link opens files here directly), but nothing in it
# should ever be executed as a script, and the directory should not be
# browsable.

Options -Indexes -ExecCGI -Includes

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|php\d|phtml|phar|pl|py|cgi|sh|exe)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "\.pdf$">
    Header set X-Content-Type-Options "nosniff"
    Header set Content-Disposition "inline"
</FilesMatch>
