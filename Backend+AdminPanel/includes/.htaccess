# Backend+AdminPanel/includes/.htaccess
#
# These files are only ever require()'d by api/*.php — they are never
# meant to be requested directly. Deny direct access defensively.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>